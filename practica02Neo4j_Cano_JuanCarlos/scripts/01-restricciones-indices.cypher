// 1. RESTRICCIONES DE UNICIDAD 
CREATE CONSTRAINT c_punto_id IF NOT EXISTS FOR (p:Punto) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT c_refugio_id IF NOT EXISTS FOR (r:Refugio) REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT c_fuente_id IF NOT EXISTS FOR (f:Fuente) REQUIRE f.id IS UNIQUE;
CREATE CONSTRAINT c_usuario_id IF NOT EXISTS FOR (u:Usuario) REQUIRE u.id IS UNIQUE;
CREATE CONSTRAINT c_ruta_id IF NOT EXISTS FOR (rg:RutaGuardada) REQUIRE rg.id IS UNIQUE;

// 2. ÍNDICES SECUNDARIOS 
CREATE INDEX idx_punto_nombre IF NOT EXISTS FOR (p:Punto) ON (p.nombre);
CREATE INDEX idx_refugio_nombre IF NOT EXISTS FOR (r:Refugio) ON (r.nombre);